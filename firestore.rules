rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'praka061996@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isCurrentUser(userId) && (
        request.resource.data.role != 'admin' || isAdmin()
      );
      allow update: if isCurrentUser(userId) && (
        // Prevent escalating to admin unless already admin
        (request.resource.data.role == resource.data.role || isAdmin())
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Shops Collection
    match /shops/{shopId} {
      allow read: if resource.data.status == 'approved' || (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.status == 'pending' || isAdmin())
      );
      allow update: if (
        isSignedIn() && resource.data.ownerId == request.auth.uid && (
          // Owner cannot self-approve without admin
          request.resource.data.status == resource.data.status || isAdmin()
        )
      ) || isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.courierId == request.auth.uid ||
        resource.data.status == 'waiting_courier' ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.courierId == request.auth.uid ||
        (resource.data.status == 'waiting_courier' && request.resource.data.courierId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin()
        );
        allow create: if isSignedIn() && (
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow update, delete: if isAdmin();
      }
    }

    // Partnership Requests
    match /partnershipRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.fromOwnerId == request.auth.uid ||
        resource.data.toOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.fromOwnerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.fromOwnerId == request.auth.uid ||
        resource.data.toOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
